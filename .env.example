# NEXUS Local & Docker Compose Configuration
# Copy to .env to customize local settings. Never commit .env or real secrets.

# Host Ports (Docker Compose)
NEXUS_BACKEND_PORT=8010
NEXUS_FRONTEND_PORT=5173

# Backend Settings
NEXUS_APP_NAME=NEXUS
NEXUS_ENVIRONMENT=development
NEXUS_DATABASE_URL=sqlite:///./data/nexus.db
NEXUS_SIM_TICK_INTERVAL_SECONDS=2.0
NEXUS_AI_MODE=deterministic
NEXUS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Optional LLM Configuration (not required; deterministic mode is default)
# NEXUS_LLM_API_KEY=
# NEXUS_LLM_BASE_URL=https://api.openai.com/v1
# NEXUS_LLM_MODEL=gpt-4o-mini

# Frontend Settings (relative /api/v1 is proxied by Nginx in Docker and Vite in local dev)
VITE_API_BASE_URL=/api/v1
